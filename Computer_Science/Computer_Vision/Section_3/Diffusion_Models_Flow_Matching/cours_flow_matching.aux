\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Distance de Wasserstein empirique $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle W$}\mathaccent "0362{W}_2$ entre échantillons générés et données, en fonction du nombre de pas d'intégration $N$ (échelle log). Le modèle OT-CFM atteint sa qualité asymptotique dès $N=1$ à $2$ pas, tandis que le modèle CFM nécessite $N\gtrsim 16$ pas pour converger au même niveau.}}{26}{figure.10}\protected@file@percent }
\newlabel{fig:cfm-otcfm-nfe}{{10}{26}{Distance de Wasserstein empirique $\widehat W_2$ entre échantillons générés et données, en fonction du nombre de pas d'intégration $N$ (échelle log). Le modèle OT-CFM atteint sa qualité asymptotique dès $N=1$ à $2$ pas, tandis que le modèle CFM nécessite $N\gtrsim 16$ pas pour converger au même niveau}{figure.10}{}}
